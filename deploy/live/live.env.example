# /etc/mot-ngay-lam-nghe/live.env (root:root 600) for mnl-live.service. DATABASE_URL comes from pg.env.
# The three switches (0 = off). The client shows an entry point only when its switch is on, so a phase can
# be turned off with `systemctl restart mnl-live`, no deploy.
LIVE_CHAT=1
LIVE_STREET=0
LIVE_DATING=0
# 💍 live wedding parties, the 30-minute reminder and the weekly guest race (live/wedding.py)
LIVE_WEDDING=0
# The page's origins: a socket from any other site is refused.
LIVE_ORIGINS=https://phocochuyen.io.vn,https://www.phocochuyen.io.vn
# Behind nginx: the client IP is X-Real-IP (for the per-IP caps).
LIVE_TRUST_PROXY=1
# Caps (defaults shown)
#LIVE_MAX_CONN=5000
#LIVE_PER_PLAYER=5
#LIVE_PER_IP=40
#LIVE_HANDSHAKES_PER_IP=60
#LIVE_PG_POOL=8
#LIVE_NEW_SECS=600
# 📌 Admin accounts, the same list as the game server's ADMIN_USERS (comma-separated usernames, any case): they post
# on Cả phố with no slow mode / wait / mute / masking and pin a message there. Empty: nobody.
ADMIN_USERS=
