# Một ngày làm nghề — cấu hình máy chủ. Sao chép thành .env rồi sửa.
# KHÔNG commit .env (đã có trong .gitignore/.dockerignore).

# Chạy trên máy cá nhân (mặc định):
HOST=127.0.0.1
PORT=8765
# GAME_DB=/duong-dan-rieng/game.sqlite3

# PostgreSQL (tùy chọn, xem docs/POSTGRES.md). Đặt DATABASE_URL thì game dùng PostgreSQL
# thay cho tệp SQLite. Mật khẩu chỉ để trong tệp env trên máy chủ (quyền 600) hoặc ~/.pgpass.
# DATABASE_URL=postgresql://phocochuyen@127.0.0.1:5432/phocochuyen
# PG_POOL=6                  # kết nối rảnh giữ lại mỗi tiến trình
# PG_POOL_MAX=12             # tối đa kết nối mỗi tiến trình (x WORKERS < max_connections)
# PG_STATEMENT_TIMEOUT_MS=10000
# PG_LOCK_TIMEOUT_MS=5000
# PG_IDLE_TX_TIMEOUT_MS=30000
# PG_SYNCHRONOUS_COMMIT=off  # chỉ khi đĩa chậm; có thể mất ~0,6 s ghi cuối nếu máy sập
# DB_POOL=0                  # SQLite: không giữ kết nối (giữ kết nối từng làm WAL phình to)

# Mở công khai qua tên miền (sau reverse proxy HTTPS như Caddy/Nginx):
# HOST=0.0.0.0
# ALLOWED_HOSTS=game.example.com
# TRUST_PROXY=1            # tin X-Forwarded-For / X-Forwarded-Proto từ proxy
# COOKIE_SECURE=1          # bắt buộc cookie Secure (tự bật khi proxy báo https)

# Giới hạn chống lạm dụng (mặc định đã hợp lý):
# COMMANDS_PER_MINUTE=360
# NEW_SESSIONS_PER_MINUTE=20
# AI_PER_MINUTE=10
# AI_GLOBAL_PER_MINUTE=60
# SESSION_IDLE_DAYS=180
# WORKERS=1            # = số CPU trên máy chủ (ví dụ 4)
# STATIC_RECHECK_SECONDS=3600  # máy chủ: stat() lại tệp tĩnh mỗi giờ (mặc định 2 s khi WORKERS=1, 300 s khi WORKERS>1)
# API_GZIP_LEVEL=1            # gzip cho phản hồi /api/ (1-9)
# MAX_THREADS=16              # yêu cầu cùng lúc mỗi tiến trình (mặc định 64)
# SAVE_CACHE_MB=300           # bộ đệm bản lưu mỗi tiến trình (0 = tắt; SQLite: mặc định tắt)
# SAVE_CACHE_VERIFY=0.01      # tỉ lệ lần trúng được so lại với cơ sở dữ liệu
# SLOW_COMMAND_MS=1500       # ghi [slow-cmd] khi một thao tác chậm hơn mức này
# SLOW_LOG_PER_MINUTE=20      # tối đa số dòng [slow-*] mỗi phút mỗi tiến trình (0 = không giới hạn)
# PRUNE_GUEST_DAYS=3
# LAZY_SAVES=0         # bật (1) khi mọi tiến trình đã chạy bản mới
# RECEIPT_DAYS=2
# RECEIPTS_PER_SAVE=200
# FEEDBACK_PER_10MIN=5     # góp ý tối đa mỗi phiên trong 10 phút
# FEEDBACK_PER_DAY=30      # góp ý tối đa mỗi phiên trong 24 giờ

# Hộp góp ý (📥 trong mục Góp ý): tên đăng nhập của tài khoản vận hành, cách nhau
# bằng dấu phẩy. Để trống = không ai xem được hộp góp ý.
# ADMIN_USERS=admin

# AI nhân vật (tùy chọn) — endpoint tương thích /v1/chat/completions.
# Khóa chỉ nằm trên máy chủ, không bao giờ gửi tới trình duyệt.
# LLM_BASE_URL=https://your-llm-gateway.example/v1
# LLM_MODEL=your-model-name
# LLM_API_KEY=
# LLM_CONCURRENCY=4

# Web push (tùy chọn). Mặc định tự tạo khóa VAPID trong thư mục storage/.
# VAPID_SUBJECT=mailto:trachanhtv.works@gmail.com
# VAPID_PRIVATE_KEY=         # base64url 32 byte, nếu muốn cố định khóa
# PUSH_DISABLED=1
