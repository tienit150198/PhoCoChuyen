# Một ngày làm nghề — cấu hình máy chủ. Sao chép thành .env rồi sửa.
# KHÔNG commit .env (đã có trong .gitignore/.dockerignore).

# Chạy trên máy cá nhân (mặc định):
HOST=127.0.0.1
PORT=8765
# GAME_NAMESPACE=storage/game # đường dẫn nhận diện khóa nền và thư mục khóa web push
# Khi nâng cấp, giữ nguyên giá trị đường dẫn GAME_DB cũ qua GAME_NAMESPACE.
# Namespace không mở tệp DB; chỉ kiểm thử dùng nó để chọn schema riêng.

# PostgreSQL là bắt buộc (xem docs/POSTGRES_ONLY.md).
# Đổi mật khẩu mẫu trước khi mở công khai. Mật khẩu có ký tự đặc biệt cần URL-encode.
POSTGRES_USER=phocochuyen
POSTGRES_DB=phocochuyen
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql://phocochuyen:change-this-local-password@127.0.0.1:5432/phocochuyen
# Với Docker Compose: đổi host trong DATABASE_URL thành postgres.
# PG_POOL=6                  # kết nối rảnh giữ lại mỗi tiến trình
# PG_POOL_MAX=12             # tối đa kết nối mỗi tiến trình (x WORKERS < max_connections)
# PG_STATEMENT_TIMEOUT_MS=10000
# PG_LOCK_TIMEOUT_MS=5000
# PG_IDLE_TX_TIMEOUT_MS=30000
# PG_SYNCHRONOUS_COMMIT=off  # chỉ khi đĩa chậm; có thể mất ~0,6 s ghi cuối nếu máy sập

# Mở công khai qua tên miền (sau reverse proxy HTTPS như Caddy/Nginx):
# HOST=0.0.0.0
# ALLOWED_HOSTS=game.example.com
# TRUST_PROXY=1            # tin X-Forwarded-For / X-Forwarded-Proto từ proxy
# COOKIE_SECURE=1          # bắt buộc cookie Secure (tự bật khi proxy báo https)

# TikTok Login Kit (tùy chọn). Tài khoản thường vẫn hoạt động khi chưa cấu hình.
# Chỉ xin user.info.basic. Dùng đúng Client key/secret của Sandbox hoặc Production;
# TIKTOK_MODE chỉ là thông tin giao diện, không thay đổi endpoint của TikTok.
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=https://game.example.com/auth/tiktok/callback
# TIKTOK_MODE=sandbox       # sandbox | production

# Giới hạn chống lạm dụng (mặc định đã hợp lý):
# COMMANDS_PER_MINUTE=360
# LIVE_VISITS=1        # ghé chỗ làm trực tiếp; mặc định theo LIVE_STREET trên live service
# NEW_SESSIONS_PER_MINUTE=20
# AI_PER_MINUTE=10
# AI_GLOBAL_PER_MINUTE=60
# SESSION_IDLE_DAYS=180
# WORKERS=1            # = số CPU trên máy chủ (ví dụ 4)
# STATIC_RECHECK_SECONDS=3600  # máy chủ: stat() lại tệp tĩnh mỗi giờ (mặc định 2 s khi WORKERS=1, 300 s khi WORKERS>1)
# SLOW_COMMAND_MS=1500       # ghi [slow-cmd] khi một thao tác chậm hơn mức này
# SLOW_LOG_PER_MINUTE=20      # tối đa số dòng [slow-*] mỗi phút mỗi tiến trình (0 = không giới hạn)
# PRUNE_GUEST_DAYS=3
# LAZY_SAVES=0         # bật (1) khi mọi tiến trình đã chạy bản mới
# RECEIPT_DAYS=2
# RECEIPTS_PER_SAVE=200
# FEEDBACK_PER_10MIN=5     # góp ý tối đa mỗi phiên trong 10 phút
# FEEDBACK_PER_DAY=30      # góp ý tối đa mỗi phiên trong 24 giờ

# Hộp góp ý (📥 trong mục Góp ý): tên đăng nhập của tài khoản vận hành, cách nhau
# bằng dấu phẩy. Để trống = không ai xem được hộp góp ý.
# ADMIN_USERS=admin

# AI nhân vật (tùy chọn) — endpoint tương thích /v1/chat/completions.
# Khóa chỉ nằm trên máy chủ, không bao giờ gửi tới trình duyệt.
# LLM_BASE_URL=https://your-llm-gateway.example/v1
# LLM_MODEL=your-model-name
# LLM_API_KEY=
# LLM_CONCURRENCY=4

# Web push (tùy chọn). Mặc định tự tạo khóa VAPID trong thư mục storage/.
# VAPID_SUBJECT=mailto:trachanhtv.works@gmail.com
# VAPID_PRIVATE_KEY=         # base64url 32 byte, nếu muốn cố định khóa
# VAPID_KEY_FILE=            # đường dẫn tới vapid.json hiện có nếu lưu ngoài storage/
# PUSH_DISABLED=1

# Google/Firebase: public SDK configuration from the web app in Firebase Console.
# No service-account private key, Analytics secret, password or player identifier here.
# Only the exact HTTPS origin below collects data, after the player's choice.
# SITE_URL=https://phocochuyen.io.vn
# FIREBASE_API_KEY=
# FIREBASE_PROJECT_ID=pho-co-chuyen
# FIREBASE_APP_ID=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_MEASUREMENT_ID=
# FIREBASE_PERFORMANCE=1
# GOOGLE_SITE_VERIFICATION=      # token only, copied from Search Console's HTML tag method

# Thị trường coin/vàng: bắt buộc khi phục vụ domain hoặc bind public/LAN.
# Tạo một chuỗi ngẫu nhiên riêng (ít nhất 24 ký tự); dùng chung cho mọi worker.
# Nếu đã có MNL_GOLD_SALT riêng đủ dài, có thể dùng nó làm seed dự phòng.
# MNL_MARKET_SALT=
# Mốc Unix giây tại lúc chuyển đổi thật, không ở tương lai. Chỉ đặt một lần.
# Không thay đổi mốc hoặc seed sau khi có giao dịch. Giữ MNL_GOLD_SALT cũ để nối giá vàng.
# MNL_MARKET_EPOCH=
